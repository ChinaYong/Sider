{
  "manifest_version": 3,
  "name": "Sider · 网页引用与提示词",
  "version": "0.6.0",
  "description": "在原版 AI 网站侧栏发送前附加划词、链接与正文，支持 ChatGPT、Gemini、Claude 和自定义网站。",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "minimum_chrome_version": "145",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "contextMenus", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://chatgpt.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "打开 Sider", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "side_panel": {"default_path": "panel.html"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["file-drop-main.js"],
    "world": "MAIN",
    "run_at": "document_start",
    "all_frames": true
  }, {
    "matches": ["https://chatgpt.com/*"],
    "js": ["ai-content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "commands": {
    "open-side-panel": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "打开 Sider 侧栏"},
    "capture-selection": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "引用当前网页划词"}
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src https: http:; base-uri 'none';"
  }
}
